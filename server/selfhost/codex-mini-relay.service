[Unit]
Description=Codex Mini multi-user relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/codex-mini
Environment=HOST=127.0.0.1
Environment=PORT=18700
Environment=CODEX_MINI_RELAY_CONFIG=/etc/codex-mini/devices.json
ExecStart=/usr/bin/node /opt/codex-mini/server/selfhost/multi-user-relay.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
